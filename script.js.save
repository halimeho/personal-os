function updateClock() {
    const now = new Date();
    const locale = localStorage.getItem("personal-os-language") === "en"
        ? "en-US" : "pt-BR";

    document.getElementById("clock").textContent =
        now.toLocaleTimeString(locale);
    document.getElementById("date").textContent =
        now.toLocaleDateString(locale);
}
updateClock();
setInterval(updateClock, 1000);

// OPEN WINDOWS
let highestZ = 10;

function openWindow(id) {
    const win = document.getElementById(id);
    if (!win) return;

    win.classList.remove("minimized");
    win.classList.add("active");
    win.style.zIndex = ++highestZ;

    if (id === "terminal") {
        setTimeout(() => {
            document.getElementById("terminal-input").focus();
        }, 50);
    }
}

document.querySelectorAll("[data-window]").forEach(button => {
    button.addEventListener("click", () => {
        openWindow(button.dataset.window);
    });
});

// CLOSE WINDOWS
document.querySelectorAll(".close-window").forEach(button => {
    button.addEventListener("click", () => {
        button.closest(".window").classList.remove("active");
    });
});

// DRAG WINDOWS
document.querySelectorAll(".window").forEach(win => {
    const header = win.querySelector(".window-header");
    let dragging = false;
    let offsetX = 0;
    let offsetY = 0;

    header.addEventListener("pointerdown", event => {
        if (event.target.closest("button")) return;

        dragging = true;
        const rect = win.getBoundingClientRect();
        offsetX = event.clientX - rect.left;
        offsetY = event.clientY - rect.top;
        win.style.transform = "none";
        win.style.left = rect.left + "px";
        win.style.top = rect.top + "px";
        win.style.zIndex = ++highestZ;
        header.setPointerCapture(event.pointerId);
    });

    header.addEventListener("pointermove", event => {
        if (!dragging) return;
        win.style.left = event.clientX - offsetX + "px";
        win.style.top = event.clientY - offsetY + "px";
    });

    header.addEventListener("pointerup", () => {
        dragging = false;
    });
});


